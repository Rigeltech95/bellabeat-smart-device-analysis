      <aliases enabled='yes' />
      <column caption='Activity Date' datatype='date' datatype-customized='true' name='[ActivityDate]' role='dimension' type='ordinal' />
      <column caption='Activity Level' datatype='string' name='[Calculation_0781501437501441]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [TotalSteps] &lt; 5000 THEN &quot;Inactive&quot;&#13;&#10;ELSEIF [TotalSteps] &lt; 7500 THEN &quot;Low Active&quot;&#13;&#10;ELSEIF [TotalSteps] &lt; 10000 THEN &quot;Moderately Active&quot;&#13;&#10;ELSE &quot;Highly Active&quot;&#13;&#10;END' />
      </column>
      <column caption='Avg Sedentary Time' datatype='real' name='[Calculation_0950826516402177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(AVG([SedentaryMinutes]) / 60, 1)' />
      </column>
