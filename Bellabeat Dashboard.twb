                <zone forceUpdate='true' h='26500' id='77' type-v2='text' w='52750' x='47167' y='70125'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Segoe UI'>Key Insights</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Segoe UI'>Avg. daily steps (6,547) are below the 10,000-step goal. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Segoe UI'>More steps lead to higher calorie burn. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Segoe UI'>Users are sedentary for 16.6 hrs/day. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Segoe UI'>Avg. sleep is 7.3 hrs/night. </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Segoe UI'>Recommendations</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Segoe UI'>Encourage daily step challenges. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Segoe UI'>Send inactivity reminders. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Segoe UI'>Personalize wellness insights. </run>
                  </formatted-text>
